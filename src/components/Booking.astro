<form class="booking" id="booking"><div class="booking-tabs"><button type="button" data-type="vols" class="active">✈ Vols</button><button type="button" data-type="hotels">▦ Hôtels</button></div><div class="booking-fields"><label>Départ / Destination<input required name="from" placeholder="Tunis, Tunisie"/></label><label>Destination / Hôtel<input required name="to" placeholder="Paris, Istanbul, Djerba..."/></label><label>Départ<input required type="date" name="date"/></label><label>Retour<input type="date" name="return"/></label><label>Voyageurs<select name="adults"><option value="1">1 adulte</option><option value="2">2 adultes</option><option value="3">3 adultes</option><option value="4">4 adultes</option></select></label><button class="btn btn-primary" type="submit">Rechercher ↗</button></div><small class="booking-note">Le parcours continue sur le moteur de réservation officiel Walid Voyages.</small></form><script>
const form=document.getElementById('booking');let type='vols';const dates=form.querySelectorAll('input[type=date]');for(const d of dates)d.min=new Date().toISOString().split('T')[0];for(const button of form.querySelectorAll('[data-type]'))button.addEventListener('click',()=>{type=button.dataset.type;form.querySelectorAll('[data-type]').forEach(b=>b.classList.toggle('active',b===button))});form.addEventListener('submit',event=>{event.preventDefault();const d=new FormData(form);const payload=Object.fromEntries(d);const oldSite=type==='vols'?'https://www.walid-voyages.com/vols':'https://www.walid-voyages.com';const template=type==='vols'?import.meta.env.PUBLIC_FLIGHTS_SEARCH_URL:import.meta.env.PUBLIC_HOTELS_SEARCH_URL;let dest=oldSite;if(template){try{const u=new URL(template);if(u.protocol==='https:'){for(const [k,v] of Object.entries(payload))u.searchParams.set(k,String(v));dest=u.href}}catch{}}sessionStorage.setItem('walid_search_intent',JSON.stringify({type,...payload,at:Date.now()}));window.open(dest,'_blank','noopener,noreferrer')});
</script>