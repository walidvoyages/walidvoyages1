
<script>
  import Layout from '../layouts/Layout.astro';import Booking from '../components/Booking.astro';import Listing from '../components/Listing.astro';
---
<Layout>
<section class="hero"><div class="hero-backdrop"></div>
<div class="container hero-content"><div class="eyebrow">✦ VOTRE PROCHAIN VOYAGE COMMENCE ICI</div>
<h1>Le monde vous attend.<br/><span>Voyagez autrement.</span></h1><p>Des destinations qui inspirent. Des voyages qui vous ressemblent. Découvrez une nouvelle expérience avec Walid Voyages.</p><a class="hero-link" href="#explorer">Découvrir nos offres <span>↗</span></a></div>
</section>
<div class="container booking-wrap"><Booking/></div>
<section class="section container" id="explorer"><div class="section-head"><div><span class="eyebrow dark">NOS SERVICES</span><h2>Tout votre voyage,<br/><em>en un seul endroit.</em></h2></div>
<p>Des vols à votre séjour, nous vous accompagnons pour chaque aventure.</p></div>
<div class="service-grid"><a class="service-tile blue" href="/vols/"><span class="service-icon">✈</span><h3>Billets d'avion</h3><p>Envolez-vous vers le monde entier.</p><span>Explorer ↗</span></a><a class="service-tile green" href="/hotels/"><span class="service-icon">▦</span><h3>Hôtels & séjours</h3><p>Le bon hôtel pour chaque envie.</p><span>Explorer ↗</span></a><a class="service-tile cream" href="/omra/"><span class="service-icon">☪</span><h3>Omra</h3><p>Des programmes préparés avec soin.</p><span>Explorer ↗</span></a><a class="service-tile sand" href="/voyages-organises/"><span class="service-icon">◈</span><h3>Voyages organisés</h3><p>Des souvenirs à partager.</p><span>Explorer ↗</span></a></div>
</section>
<section class="section section-tint"><div class="container"><div class="section-head"><div><span class="eyebrow dark">PROGRAMMES</span><h2>Votre prochaine <em>Omra</em></h2></div>
<a class="text-link" href="/omra/">Tous les programmes ↗</a></div>
<Listing kind="omra"/></div>
</section>
<section class="section container"><div class="section-head"><div><span class="eyebrow dark">INSPIRATIONS</span><h2>Découvrez nos <em>séjours</em></h2></div>
<a class="text-link" href="/hotels/">Tous les hôtels ↗</a></div>
<Listing kind="hotels"/></section>
<section class="statement"><div class="container statement-inner"><span class="eyebrow">L'EXPÉRIENCE WALID VOYAGES</span><h2>Votre voyage.<br/>Notre engagement.</h2><p>Une équipe à votre écoute, des agences proches de vous et une réservation en ligne sur notre plateforme officielle.</p><div><a class="btn btn-white" href="/agences/">Trouver une agence ↗</a><a class="btn btn-ghost" href="https://www.walid-voyages.com" target="_blank" rel="noopener">Réserver en ligne ↗</a></div>
</div>
</section>
<section class="section container"><div class="section-head"><div><span class="eyebrow dark">ACTUALITÉS & CONSEILS</span><h2>Le carnet <em>de voyage</em></h2></div>
<a href="/actualites/" class="text-link">Tous les articles ↗</a></div>
<Listing kind="articles"/></section>

</Layout>

<script>
  import { db } from '../lib/firebase.js';
  import { ref, onValue } from 'firebase/database';

  onValue(ref(db, 'public/banners/home'), (snapshot) => {
    const banner = snapshot.val();
    if (!banner) return;

    const title = document.querySelector('.hero h1');
    const subtitle = document.querySelector('.hero-content > p');
    const hero = document.querySelector('.hero');

    if (typeof banner.title === 'string' && title) title.textContent = banner.title;
    if (typeof banner.subtitle === 'string' && subtitle) subtitle.textContent = banner.subtitle;

    if (typeof banner.image === 'string' && hero instanceof HTMLElement) {
      try {
        const image = new URL(banner.image);
        if (image.protocol === 'https:' &&
            image.hostname === 'res.cloudinary.com' &&
            image.pathname.startsWith('/xvncs8ud/image/upload/')) {
          hero.style.backgroundImage = `url("${image.href}")`;
        }
      } catch (error) {
        console.warn('Invalid Cloudinary banner image', error);
      }
    }
  });
</script>

</script>
