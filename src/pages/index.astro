
<script>
  import { db } from '../lib/firebase.js';
  import { ref, onValue } from 'firebase/database';

  const bannerRef = ref(db, 'public/banners/home');

  onValue(bannerRef, (snapshot) => {
    const banner = snapshot.val();

    if (!banner) return;

    const title = document.querySelector('.hero h1');
    const subtitle = document.querySelector('.hero-content > p');
    const hero = document.querySelector('.hero');

    if (banner.title && title) {
      title.textContent = banner.title;
    }

    if (banner.subtitle && subtitle) {
      subtitle.textContent = banner.subtitle;
    }

    if (banner.image && hero instanceof HTMLElement) {
      try {
        const url = new URL(banner.image);

        if (
          url.protocol === 'https:' &&
          url.hostname === 'res.cloudinary.com' &&
          url.pathname.startsWith('/xvncs8ud/image/upload/')
        ) {
          hero.style.backgroundImage = `url("${url.href}")`;
        }
      } catch (error) {
        console.error('Invalid Cloudinary URL', error);
      }
    }
  });
</script>
